          onClick={save}>
          حفظ المقارنة
        </button>
      </> : <>
        <button type="button" className={primary + " mb-3 w-full"} disabled={!ready}
          onClick={() => edit({
            id: "new-" + Date.now() + "-" + crypto.getRandomValues(new Uint32Array(2)).join("-"),
            rev: 0
          })}>
