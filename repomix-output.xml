  /*
    محاولة أخيرة عند إغلاق التبويب.

    هذا Best effort فقط؛ المتصفح قد يغلق
    قبل اكتمال طلب الشبكة.
  */
  useEffect(() => {
    if (!authorized) return undefined;

    const handleBeforeUnload = () => {
      if (saveTimerRef.current) {
