  max-inline-size: 100%;
  margin: 0 0 8px;
}
.wc .wc-fast-booking .wc-field > input:is([type="date"],[type="time"]) {
  box-sizing: border-box;
  inline-size: 100%;
  min-inline-size: 0;
  max-inline-size: 100%;
  min-height: 46px;
  padding-inline: 8px;
  font-size: 16px;
  line-height: normal;
  font-variant-numeric: tabular-nums;
}
.wc .wc-fast-booking input:is([type="date"],[type="time"])::-webkit-date-and-time-value {
  min-width: 0;
  margin: 0;
