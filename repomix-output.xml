}


/* calendar-explicit-navigation-v1 */
.wc .wc-days-only {
  display:grid;grid-template-columns:auto minmax(0,1fr) auto;
  align-items:stretch;gap:5px;margin:6px 0;
}
.wc .wc-days-only>button,.wc .wc-month-paging button,.wc .wc-picker-heading button {
  min-height:44px;border:1px solid var(--wc-border);border-radius:10px;
  color:var(--cal-navy);background:var(--wc-paper);
  font-size:14px;font-weight:650;padding:5px 9px;
}
.wc .wc-days-only .wc-open-picker {
  display:flex;align-items:center;justify-content:center;gap:6px;
  background:var(--wc-soft);font-variant-numeric:tabular-nums;
}
.wc .wc-open-picker>span {display:grid;justify-items:center;line-height:1.25}
.wc .wc-open-picker small {font-size:12px}
.wc .wc-open-picker svg {flex-shrink:0}
.wc header.wc-picker-heading {
  position:static;display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:6px 12px;margin:6px 0 0;padding:5px 0;border:0;
  background:transparent;
}
.wc .wc-picker-heading small {font-size:13px;color:var(--wc-secondary)}
.wc .wc-picker-heading h3 {margin:1px 0 0;font-size:19px;color:var(--cal-navy)}
.wc .wc-month-paging {
  display:flex;justify-content:space-between;gap:8px;
  padding:8px 3px 0;margin-top:5px;border-top:1px solid var(--wc-border);
}
@media(max-width:350px){
  .wc .wc-days-only>button {font-size:13px;padding-inline:5px}
  .wc .wc-days-only .wc-open-picker {gap:3px}
}

/* calendar-fixed-toggle-v1 */
.la-app .la-brand {min-height:54px;padding-block:4px}
.la-app .la-brand h1 {gap:7px}
.la-app .la-brand .la-section-name {font-size:20px;line-height:1.3}
.la-app .la-brand .la-section-icon {
  width:32px;height:32px;flex-basis:32px;border-radius:10px;
}
.la-app .la-brand > button.la-signout {
  display:grid;place-items:center;flex:0 0 44px;width:44px;height:44px;
  padding:0;color:var(--lumora-text-soft,#5f6878);
  background:transparent;border:0;border-radius:10px;
}
.la-app .la-brand > button.la-signout::after {content:none}
.wc .wc-fixed-toolbar {
  display:grid;grid-template-columns:44px minmax(0,1fr);
  align-items:center;gap:5px;min-height:48px;margin:5px 0;
}
.wc .wc-calendar-toggle,.wc .wc-day-strip button {
  min-height:44px;background:var(--wc-paper);color:var(--cal-navy);
  border:1px solid var(--wc-border);border-radius:10px;
}
.wc .wc-calendar-toggle {display:grid;place-items:center;width:44px;padding:0}
.wc .wc-calendar-toggle[aria-pressed=true] {
  background:var(--cal-navy);border-color:var(--cal-navy);color:white;
}
.wc .wc-day-strip {
  display:grid;grid-template-columns:auto minmax(0,1fr) auto;
  align-items:center;gap:3px;min-width:0;
}
.wc .wc-day-strip button {
  font-size:13px;font-weight:650;padding:4px 6px;line-height:1.25;
}
.wc .wc-selected-date {
  display:grid;justify-items:center;gap:1px;
  color:var(--cal-navy);font-size:14px;font-weight:700;font-variant-numeric:tabular-nums;
}
.wc .wc-selected-date small,.wc .wc-month-caption small {
  font-size:12px;line-height:1.3;color:var(--wc-secondary);
}
.wc .wc-month-caption {display:grid;gap:1px;padding-inline:5px}
.wc .wc-month-caption strong {font-size:17px;color:var(--cal-navy)}
@media(max-width:350px){
  .wc .wc-day-strip button {padding-inline:4px;font-size:12px}
  .wc .wc-selected-date {font-size:13px}
}


/* calendar-fast-booking-v1 */
.wc .wc-fast-booking,
.wc .wc-fast-booking .wc-form-scroll,
.wc .wc-fast-booking .wc-booking-section,
.wc .wc-fast-booking .wc-grid,
.wc .wc-fast-booking .wc-field,
.wc .wc-fast-booking .wc-customer-picker {
  box-sizing:border-box;min-width:0;max-width:100%;
}
.wc .wc-fast-booking {width:100%}
.wc .wc-fast-booking .wc-form-scroll {
  width:100%;overflow-y:auto;overflow-x:hidden;
  overscroll-behavior-x:none;touch-action:pan-y pinch-zoom;
  padding:3px 2px 12px;
}
.wc .wc-fast-booking .wc-grid {
  grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;
}
.wc .wc-fast-booking .wc-booking-section[aria-label="الزبون"] {
  grid-template-columns:minmax(0,1fr) auto;
}
.wc .wc-fast-booking .wc-field {grid-template-columns:minmax(0,1fr)}
.wc .wc-fast-booking input:not([type=checkbox]),
.wc .wc-fast-booking select {
  display:block;width:100%;min-width:0;max-width:100%;
  box-sizing:border-box;font-size:16px;
}
.wc .wc-fast-booking input[type=date],
.wc .wc-fast-booking input[type=time] {
  min-inline-size:0;max-inline-size:100%;text-align:start;
}
.wc .wc-fast-booking .wc-service input:not([type=checkbox]) {width:84px}
.wc .wc-fast-booking .wc-booking-section {
  margin-bottom:8px;padding:11px;border-radius:13px;
}
.wc .wc-fast-booking .wc-booking-section>h3 {
  margin:0 0 8px;font-size:15px;
}
.wc .wc-fast-booking .wc-extra-section {padding:0 11px}
.wc .wc-fast-booking .wc-extra-toggle {
  display:flex;align-items:center;justify-content:space-between;gap:8px;
  width:100%;min-height:46px;padding:4px 0;
  background:transparent;border:0;text-align:start;
  color:var(--wc-text);font-size:14px;font-weight:650;
}
.wc .wc-extra-toggle>span:last-child {
