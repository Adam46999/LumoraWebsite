                  bg-[var(--lumora-navy-900)]
                  sm:h-12
                  sm:w-12
                "
              >
                <img
                  src="/lumora-icon.png"
                  alt=""
                  aria-hidden="true"
                  draggable={false}
                  className="h-full w-full object-cover"
                />
              </span>

              <span className="hidden sm:block">
                <span
                  className="
                    block
                    text-[16px]
                    font-black
                    leading-none
                    tracking-[0.08em]
                    text-white
                  "
                >
                  {text.brand}
                </span>

                <span
                  className="
                    mt-1
                    block
                    text-[8px]
                    font-black
                    leading-none
                    tracking-[0.3em]
                    text-[var(--lumora-lime)]
                  "
                >
                  {text.brandSub}
                </span>
              </span>
            </button>

            {/* Desktop navigation */}
            <nav
