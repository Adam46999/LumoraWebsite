              <div>
                <div className="text-[11px] text-slate-600 mb-1">المبلغ</div>
                <input
                  type="number"
                  inputMode="decimal"
                  value={e.amount ?? ""}
                  onChange={(ev) => {
                    const val = ev.target.value;
                    setEntries((prev) =>
                      (prev || []).map((x) => {
                        if (x.id !== e.id) return x;
                        if (x.type === "product")
                          return { ...x, amount: val, shop: val };
                        return { ...x, amount: val };
                      })
                    );
                  }}
