/* إذا الخانتين ما بيسعوا براحة، منعرضهم تحت بعض. */
@container booking-times (max-width: 278px) {
  .wc .wc-fast-booking .wc-booking-section .wc-grid:has(input[type="time"]) {
    grid-template-columns: minmax(0, 1fr);
    inline-size: min(100%, 12.5rem);
    gap: 0;
  }
}


/* booking-iphone-schedule-v1 */
.wc .wc-fast-booking .wc-book-picker {
  display:grid;min-width:0;margin:0;gap:4px;
}
.wc .wc-fast-booking .wc-picker-label,
.wc .wc-fast-booking .wc-book-price-row .wc-field>span {
  font-size:14px;font-weight:650;line-height:1.45;color:var(--wc-text);
