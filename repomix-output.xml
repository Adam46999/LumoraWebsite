              {typeLabel(e.type)}
            </span>

            <div className="text-[13px] font-extrabold text-slate-900 truncate">
              {e.title || "بدون عنوان"}
            </div>

            {e.customerName ? (
              <span className="text-[11px] text-slate-500 truncate">
