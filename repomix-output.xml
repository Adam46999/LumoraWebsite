      const ref=refFor(r.id), entryId="visit-"+r.id;
      const entry=doc(db,"lumora_finance",uid,"entries",entryId);
      await runTransaction(db,async tx => {
        const old=(await tx.get(ref)).data(), existing=(await tx.get(entry)).exists();
