.wc .wc-fast-booking .wc-booking-section{margin:0;padding:10px 4px 12px;border:0;border-radius:0;background:transparent;box-shadow:none}.wc .wc-fast-booking .wc-booking-section+.wc-booking-section{border-top:1px solid var(--wc-border)}.wc .wc-fast-booking .wc-booking-section>h3{margin:0 0 7px;padding:0;border:0;color:var(--cal-navy);font-size:15px}.wc .wc-fast-booking .wc-booking-section>h3::before{display:none}.wc .wc-fast-booking .wc-book-picker-date{grid-template-columns:minmax(0,1fr);gap:4px;margin-bottom:9px}.wc .wc-fast-booking .wc-book-time-pair{margin-bottom:9px;column-gap:12px}.wc .wc-fast-booking .wc-book-price-row .wc-field{display:flex;align-items:center;justify-content:flex-start;gap:12px}.wc .wc-fast-booking .wc-book-price-row input{width:7rem;max-width:40%;min-width:0}.wc .wc-fast-booking .wc-picker-box,.wc .wc-fast-booking .wc-field input:not([type=checkbox]){background:white;border-color:#cdd6ce;border-radius:9px;min-height:44px}.wc .wc-fast-booking .wc-extra-section{padding:0 4px;background:transparent}.wc .wc-fast-booking .wc-extra-toggle{min-height:46px;font-weight:600}.wc .wc-fast-booking .wc-extra-toggle>span:last-child{border:0;background:transparent;color:var(--cal-navy);font-size:18px}.la-page>.wc[data-form=true]>header[data-admin-step]{min-height:40px;margin-bottom:2px;padding-block:3px;border-bottom:0}.wc .wc-fast-booking .wc-submit{border-top:1px solid var(--wc-border);padding-block:7px max(7px,env(safe-area-inset-bottom))}


