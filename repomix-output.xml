      setFeedback("اكتب اسم بلد صالح."); input.current?.focus(); return;
    }
    if (action === "remove" && !window.confirm("تشيل " + oldName + " من خيارات الحجز؟ المواعيد القديمة بتضل محفوظة.")) return;
    saving.current = true;
    setPending(true);
    setFeedback("");
    try {
      const ref = doc(db,"lumora_calendar",uid,"settings","towns");
      await runTransaction(db,async tx=>{
        const snapshot = await tx.get(ref);
        const list = snapshot.exists() ? snapshot.data().names : towns;
        if (!Array.isArray(list)) throw Error("تعذّر قراءة قائمة البلاد.");
        if (oldName !== null && !list.includes(oldName))
          throw Error("القائمة تغيّرت من جهاز ثاني. اختار البلد من جديد.");
        if (action !== "remove" && list.some(name=>name !== oldName && clean(name) === nextName))
          throw Error("هالبلد موجودة بالقائمة.");
        const updated = action === "remove" ? list.filter(name=>name !== oldName) :
          action === "rename" ? list.map(name=>name === oldName ? nextName : name) :
          [...list,nextName];
        tx.set(ref,{names:updated});
      });
      setEditing(null); setValue("");
      setFeedback(action === "remove" ? "انشالت البلد من الخيارات." :
        action === "rename" ? "تم تعديل اسم البلد." : "انضافت البلد للخيارات.");
    } catch (e) {
      setFeedback(e.code ? "تعذّر حفظ إعدادات البلاد. افحص الاتصال وصلاحية الإعدادات." : e.message);
    } finally { saving.current=false; setPending(false); }
  }

  return <dialog ref={modal} className="wc-town-settings" dir="rtl"
    aria-labelledby="wc-settings-title" onCancel={e=>{e.preventDefault(); if (!saving.current) onClose();}}>
    <header><h2 id="wc-settings-title">إعدادات المواعيد</h2>
      <button type="button" disabled={pending} onClick={onClose}>إغلاق</button></header>
    <h3>بلاد الحجز</h3>
    <form onSubmit={e=>{e.preventDefault(); apply(editing === null ? "add" : "rename", editing);}}>
      <label htmlFor="wc-town-name">{editing === null ? "إضافة بلد" : "تعديل اسم البلد"}</label>
      <div className="wc-town-entry">
        <input id="wc-town-name" ref={input} dir="auto" required value={value}
          disabled={pending} placeholder="اسم البلد" onChange={e=>setValue(e.target.value)}/>
        <button disabled={!available || pending}>{editing === null ? "إضافة" : "حفظ"}</button>
        {editing !== null && <button type="button" disabled={pending}
          onClick={()=>{setEditing(null);setValue("");}}>إلغاء</button>}
      </div>
    </form>
    {!available && <p role="status">بانتظار الاتصال بإعدادات البلاد.</p>}
    <p role="status" aria-live="polite">{feedback}</p>
    <ul>{names.map(name=><li key={name}>
      <bdi dir="auto">{name}</bdi>
      <button type="button" aria-label={"تعديل " + name} disabled={!available || pending}
        onClick={()=>{setEditing(name);setValue(name);setFeedback("");input.current?.focus();}}>تعديل</button>
      <button type="button" className="wc-town-remove" aria-label={"إزالة " + name}
        disabled={!available || pending} onClick={()=>apply("remove",name)}>إزالة</button>
    </li>)}</ul>
  </dialog>;
}

function CalendarBody({ uid, close, embedded=false, leaveGuard, schedulePosition, actionHost }) {
  const Surface=embedded ? "section" : "dialog";
  const [bookingTowns,setBookingTowns] = useState(towns);
  const [townsReady,setTownsReady] = useState(false);
  const [settingsOpen,setSettingsOpen] = useState(false);
  const [rows,setRows] = useState([]), [ready,setReady] = useState(false);
  const [loadError,setLoadError] = useState(""), [retry,setRetry] = useState(0);
  useEffect(()=>{
    setTownsReady(false);
