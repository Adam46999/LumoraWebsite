      <div className="wc-hour-heading"><strong>{title}</strong>
        <button type="button" autoFocus onClick={()=>popup.current.close()}>إغلاق</button>
      </div>
      <div className="wc-hour-grid">
        {halfHourChoices.map(time=><button key={time} type="button" data-time={time}
          disabled={!!after && time<=after} aria-pressed={value===time}
          onClick={()=>pick(time)}><bdi dir="ltr">{time}</bdi></button>)}
      </div>
      {after && !halfHourChoices.some(time=>time>after) &&
        <p>ما في وقت نهاية بعد ساعة الوصول بنفس اليوم. فيك تتركها فاضية.</p>}
      {optional && value && <button type="button" className="wc-hour-clear"
        onClick={()=>pick("")}>مسح وقت النهاية</button>}
    </dialog>
  </div>;
}

