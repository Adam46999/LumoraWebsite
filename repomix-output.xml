    const clean = draft.phone.replace(/\D/g, "");
    const normalized = clean.startsWith("972")
      ? `+${clean}`
      : clean.startsWith("0")
        ? `0${clean.slice(1)}`
        : draft.phone.trim();

    if (!draft.phone.trim()) {
