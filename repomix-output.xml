  return {
    kind: f.kind, date: f.date, total, wallet, to, name: f.name.trim(),
    note: f.note.trim(), category: f.kind === "cost" ? f.category : "", lines,
    payments: paid ? [{ id: f.id, date: f.date, wallet, amount: paid }] : [],
