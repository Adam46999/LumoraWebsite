  const links = value.match(/https:\/\/[^\s<>"']+/gi) || [];
  for (const link of links) {
    try {
      const u = new URL(link);
      if (!u.username && !u.password && !u.port &&
          ["waze.com","www.waze.com","ul.waze.com"].includes(u.hostname)) return u.href;
    } catch {}
