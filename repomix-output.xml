                  options={[
                    {
                      value: MATTRESS_SIDES.ONE,
                      label: text.mattressOneSide,
                    },
                    {
                      value: MATTRESS_SIDES.TWO,
                      label: text.mattressTwoSides,
                    },
                  ]}
                  selectedValue={mattressSides}
                  onSelect={setMattressSides}
                />

                <div
                  className="
                    rounded-xl
                    border
                    border-[rgba(16,148,192,0.14)]
                    bg-[rgba(16,148,192,0.06)]
                    px-3.5
                    py-3
                    text-xs
                    font-bold
                    leading-5
                    text-slate-600
                  "
                >
                  {text.mattressPricingHint}
                </div>
              </div>
            )}

            {/* Carpet fields */}
            {isCarpet && (
              <div className="space-y-5">
                <div>
                  <div className="flex items-center justify-between gap-3">
                    <label
                      htmlFor="carpet-quantity"
                      className="
                        text-sm
                        font-black
                        text-[var(--lumora-navy-900)]
                      "
                    >
                      {text.carpetCountLabel}
                    </label>

                    <span
                      className="
                        rounded-full
                        bg-slate-100
                        px-2
                        py-1
                        text-[10px]
                        font-bold
                        text-slate-500
                      "
                    >
                      {text.carpetCountOptional}
                    </span>
                  </div>

                  <input
                    id="carpet-quantity"
                    type="number"
                    min="1"
                    inputMode="numeric"
                    value={carpetQuantity}
                    onChange={(event) => {
                      const nextValue = event.target.value;

                      if (nextValue === "" || Number(nextValue) >= 1) {
                        setCarpetQuantity(nextValue);
                      }
                    }}
                    className="
                      mt-2
                      h-12
                      w-full
                      rounded-xl
                      border
                      border-slate-200
                      bg-white
                      px-4
                      text-sm
                      font-bold
                      text-slate-900
                      outline-none
                      transition
                      focus:border-[var(--lumora-cyan)]
                      focus:ring-2
                      focus:ring-[rgba(16,148,192,0.12)]
                    "
                  />
                </div>

                <ChoiceSection
                  icon={<Ruler className="h-4 w-4" />}
                  label={text.carpetPriceLabel}
                  error={
                    showErrors && !carpetPriceOptionValid
                      ? text.carpetOptionError
                      : ""
                  }
                  columns="grid-cols-1"
                  options={[
                    {
                      value: CARPET_PRICE_OPTIONS.MEASUREMENTS,
                      label: text.carpetMeasurements,
                      description: text.carpetMeasurementsHint,
                    },
                    {
                      value: CARPET_PRICE_OPTIONS.METER_PRICE,
                      label: text.carpetMeterPrice,
                      description: text.carpetMeterPriceHint,
                    },
                    {
                      value: CARPET_PRICE_OPTIONS.ON_SITE_MEASURE,
                      label: text.carpetOnSite,
                      description: text.carpetOnSiteHint,
                    },
                  ]}
                  selectedValue={carpetPriceOption}
                  onSelect={setCarpetPriceOption}
                />
              </div>
            )}
          </div>
        </div>

        {/* Footer */}
        <footer
          className="
            shrink-0
            border-t
            border-slate-200
            bg-white
            px-4
            pb-[max(16px,env(safe-area-inset-bottom))]
            pt-4
            sm:px-6
            sm:pb-5
          "
        >
          <p className="mb-3 text-center text-xs text-slate-500">
            {text.orderSummary}
          </p>

          <button
            type="button"
            onClick={handleSubmit}
            className="
              flex
              h-12
              w-full
              items-center
              justify-center
              gap-2
              rounded-xl
              bg-[var(--lumora-lime)]
              px-5
              text-sm
              font-black
              text-[var(--lumora-navy-950)]
              shadow-[0_10px_24px_rgba(79,168,37,0.20)]
              transition
              hover:brightness-105
              active:scale-[0.99]
            "
          >
            <MessageCircle aria-hidden="true" className="h-5 w-5" />

            <span>{text.submit}</span>
          </button>
        </footer>
      </section>
    </div>
  );
}

function QuantityField({ label, hint, value, onChange }) {
  const normalizedValue = normalizePositiveInteger(value);

  const decrease = () => {
    onChange(Math.max(1, normalizedValue - 1));
  };

  const increase = () => {
    onChange(normalizedValue + 1);
  };

  return (
    <div>
      <div className="flex items-center justify-between gap-4">
        <div className="min-w-0">
          <p
            className="
              text-sm
              font-black
              text-[var(--lumora-navy-900)]
            "
          >
            {label}
          </p>

          <p className="mt-1 text-xs leading-5 text-slate-500">{hint}</p>
        </div>

        <div
          className="
            flex
            shrink-0
            items-center
            gap-2
            rounded-xl
            border
            border-slate-200
            bg-[#f7f9f5]
            p-1
          "
        >
          <button
            type="button"
            onClick={decrease}
            disabled={normalizedValue <= 1}
            className="
              flex
              h-9
              w-9
              items-center
              justify-center
              rounded-lg
              bg-white
              text-[var(--lumora-navy-900)]
              shadow-sm
              transition
              hover:bg-slate-50
              disabled:cursor-not-allowed
              disabled:opacity-35
              active:scale-95
            "
          >
            <Minus aria-hidden="true" className="h-4 w-4" />
          </button>

          <input
            type="number"
            min="1"
            inputMode="numeric"
            value={value}
            onChange={(event) => {
              const nextValue = event.target.value;

              if (nextValue === "") {
                onChange("");
                return;
              }

              onChange(normalizePositiveInteger(nextValue));
            }}
            className="
              h-9
              w-11
              bg-transparent
              text-center
              text-base
              font-black
              text-[var(--lumora-navy-900)]
              outline-none
            "
          />

          <button
            type="button"
            onClick={increase}
            className="
              flex
              h-9
              w-9
              items-center
              justify-center
              rounded-lg
              bg-[var(--lumora-navy-900)]
              text-white
              transition
              hover:bg-[var(--lumora-navy-800)]
              active:scale-95
            "
          >
            <Plus aria-hidden="true" className="h-4 w-4" />
          </button>
        </div>
      </div>
    </div>
  );
}

function ChoiceSection({
  icon = null,
  label,
  hint = "",
  error = "",
  options,
  selectedValue,
  onSelect,
  columns = "grid-cols-2",
}) {
  return (
    <div>
      <div
        className="
          flex
          items-center
          gap-2
          text-sm
          font-black
          text-[var(--lumora-navy-900)]
        "
      >
        {icon && <span className="text-[var(--lumora-cyan)]">{icon}</span>}

        <span>{label}</span>
      </div>

      {hint && <p className="mt-1 text-xs leading-5 text-slate-500">{hint}</p>}

      <div className={`mt-3 grid gap-2 ${columns}`}>
        {options.map((option) => {
          const active = selectedValue === option.value;

          return (
            <button
              key={option.value}
              type="button"
              onClick={() => onSelect(option.value)}
              aria-pressed={active}
              className={[
                "relative rounded-xl border",
                "px-3 py-3 text-start",
                "transition-all duration-150",
                active
                  ? [
                      "border-[rgba(174,221,57,0.70)]",
                      "bg-[rgba(174,221,57,0.11)]",
                      "text-[var(--lumora-navy-900)]",
                      "ring-2",
                      "ring-[rgba(174,221,57,0.12)]",
                    ].join(" ")
                  : [
                      "border-slate-200",
                      "bg-white",
                      "text-slate-700",
                      "hover:border-[rgba(16,148,192,0.35)]",
                      "hover:bg-slate-50",
                    ].join(" "),
              ].join(" ")}
            >
              <div className="flex items-center gap-2">
                <span className="flex-1 text-sm font-black">
                  {option.label}
                </span>

                {active && (
                  <CheckCircle2
                    aria-hidden="true"
                    className="
                      h-4
                      w-4
                      shrink-0
                      text-[var(--lumora-green)]
                    "
                  />
                )}
              </div>

              {option.description && (
                <p
                  className="
                    mt-1
                    text-xs
                    font-medium
                    leading-5
                    text-slate-500
                  "
                >
                  {option.description}
                </p>
              )}
            </button>
          );
        })}
      </div>

      {error && <p className="mt-2 text-xs font-bold text-rose-600">{error}</p>}
    </div>
  );
}
</file>

