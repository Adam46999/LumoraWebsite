.wc .wc-card .wc-card-toggle {
  width: 100%;
  min-width: 0;
  min-height: 52px;
  padding: 10px 12px 6px;
  color: var(--cal-navy);
}
.wc .wc-card-headline {
  display: grid;
  grid-template-columns: minmax(0,1fr) 16px;
  align-items: center;
  gap: 2px 6px;
}
.wc .wc-card-headline strong {
  grid-column: 1;
  grid-row: 1;
  font-size: 18px;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.wc .wc-card-headline .wc-time {
  grid-column: 1;
  grid-row: 2;
  justify-self: start;
  font-size: 14px;
