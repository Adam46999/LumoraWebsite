              "text-sm font-bold transition",

              active
                ? [
                    "bg-[rgba(174,221,57,0.10)]",
                    "text-[var(--lumora-lime-light)]",
                  ].join(" ")
                : [
                    "text-white/72",
                    "hover:bg-white/[0.06]",
                    "hover:text-white",
                  ].join(" "),
            ].join(" ")}
          >
            <span
              className="
