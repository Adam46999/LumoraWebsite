  .wc,.wc * {scroll-behavior:auto}
}


/* calendar-lumora-colors-v1 */
.wc, .wc-launch {
  --cal-navy: var(--lumora-navy-900, #11152f);
  --cal-deep: var(--lumora-navy-950, #080c1d);
  --cal-lime: var(--lumora-lime, #aedd39);
  --cal-cyan: var(--lumora-cyan, #1094c0);
  --cal-action: linear-gradient(135deg,
    var(--lumora-lime-light, #c4ec5b), var(--cal-lime) 50%, #8fd020);
}
.wc {
  --wc-paper: var(--lumora-white, #fff);
  --wc-surface: var(--lumora-surface, #f5f7f2);
  --wc-brand: var(--cal-navy);
  --wc-text: var(--lumora-text, #11152f);
  --wc-secondary: var(--lumora-text-soft, #5f6878);
  --wc-border: var(--lumora-border, #dfe5dc);
  --wc-soft: var(--lumora-ice, #ecefe5);
  --ink: var(--wc-text);
  --muted: var(--wc-secondary);
  --line: var(--wc-border);
  --green: var(--cal-navy);
  background: var(--wc-surface);
  color: var(--wc-text);
  border-color: var(--wc-border);
}
.wc::backdrop { background: rgba(8,12,29,.65); }

.wc header, .wc .wc-submit { background: var(--wc-surface); }
.wc .wc-card, .wc .wc-booking-section, .wc .wc-day,
.wc button, .wc a, .wc input:not([type=checkbox]), .wc select {
  border-color: var(--wc-border);
}
.wc .wc-booking-section input:not([type=checkbox]),
.wc .wc-booking-section select, .wc .wc-empty {
  background: var(--lumora-surface-soft, #f9faf7);
}
.wc .wc-empty, .wc .wc-card-note, .wc .wc-work {
  border-color: var(--wc-border);
}

.wc-launch, .wc .wc-contact a.wc-primary, .wc .wc-submit button.wc-primary {
  color: var(--cal-deep);
  background: var(--cal-action);
  border-color: var(--cal-lime);
}
.wc .wc-tools > .wc-primary, .wc .wc-work > button {
  background: var(--wc-paper);
  color: var(--cal-navy);
  border-color: var(--wc-border);
}
.wc nav { background: var(--wc-soft); }
.wc nav button { border-color: transparent; }
.wc nav button[aria-pressed=true] {
  background: var(--cal-navy);
  border-color: var(--cal-navy);
  color: var(--wc-paper);
}
.wc .wc-card[data-next=true] {
  border-color: var(--wc-border);
  border-inline-start-color: var(--cal-lime);
}
.wc .wc-next, .wc .wc-month button small {
  background: var(--wc-soft);
  color: var(--cal-navy);
}
.wc .wc-month button[data-today=true] { border-color: var(--cal-navy); }
.wc .wc-day[data-empty=false] { border-inline-start-color: var(--cal-navy); }
.wc .wc-job-items li { background: var(--lumora-surface, #f5f7f2); }
.wc .wc-add-location {
  color: var(--cal-navy);
  background: var(--wc-paper);
  border-color: var(--cal-cyan);
}
.wc .wc-search:focus-visible, .wc :focus-visible {
  outline-color: var(--cal-cyan);
}
.wc input[type=checkbox] { accent-color: var(--cal-navy); }
.wc .wc-msg {
  color: var(--wc-text);
  background: var(--wc-paper);
  border-color: var(--cal-cyan);
}


/* calendar-day-nav-v1 */
.wc .wc-search-toggle {
  display:grid;place-items:center;width:48px;min-height:48px;padding:0;
  color:var(--cal-navy);background:var(--wc-paper);
}
.wc .wc-search-toggle[aria-expanded=true] {
  background:var(--wc-soft);border-color:var(--cal-navy);
}
.wc .wc-day-controls {
  direction:rtl;display:grid;grid-template-columns:48px minmax(0,1fr) 48px;
  align-items:stretch;gap:6px;margin:8px 0;
}
.wc .wc-day-controls>button {
  display:grid;place-items:center;min-height:48px;padding:0;
