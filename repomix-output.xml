              <div className="sm:col-span-2">
                <div className="text-[11px] text-slate-600 mb-1">العنوان</div>
                <input
                  value={e.title || ""}
                  onChange={(ev) => {
                    const val = ev.target.value;
                    setEntries((prev) =>
                      (prev || []).map((x) =>
                        x.id === e.id ? { ...x, title: val } : x
                      )
                    );
                  }}
