  position:absolute;inset:0;width:100%;height:100%;
  min-width:0;margin:0;opacity:0;cursor:pointer;
}
.wc .wc-date-picker:focus-within {
  outline:3px solid var(--cal-cyan);outline-offset:2px;
}
.wc .wc-back-today {
  display:block;margin:0 0 5px auto;color:var(--wc-secondary);
  background:transparent;border-color:transparent;font-size:14px;
}
.wc .wc-swipe-day {min-height:150px;touch-action:pan-y pinch-zoom}


/* calendar-clear-nav-v1 */
.wc .wc-period-nav {
  display:grid;
  direction:rtl;
  grid-template-columns:minmax(60px,auto) minmax(0,1fr) minmax(60px,auto);
  align-items:stretch;
  gap:6px;
  margin:9px 0;
}
.wc .wc-period-prev {grid-column:1;grid-row:1}
.wc .wc-period-date {grid-column:2;grid-row:1}
.wc .wc-period-next {grid-column:3;grid-row:1}
.wc .wc-period-nav>button {
  min-height:48px;padding:7px 10px;
  font-weight:700;color:var(--cal-navy);background:var(--wc-paper);
}
.wc .wc-period-date {
  position:relative;min-width:0;min-height:50px;
  display:grid;place-items:center;text-align:center;
  background:var(--wc-paper);border:1px solid var(--wc-border);
  border-radius:10px;color:var(--cal-navy);
}
.wc .wc-period-date[data-current=true] {
  background:#f3f9df;
  border-color:var(--cal-lime);
}
.wc .wc-period-caption {display:grid;justify-items:center;gap:1px;padding:4px}
.wc .wc-period-caption small {font-size:13px;font-weight:700;line-height:1.3}
.wc .wc-period-caption strong {font-size:16px;line-height:1.4;font-variant-numeric:tabular-nums}
.wc .wc-period-date input[type=date] {
  position:absolute;inset:0;width:100%;height:100%;min-width:0;
  margin:0;opacity:0;cursor:pointer;
}
.wc .wc-period-date:focus-within {outline:3px solid var(--cal-cyan);outline-offset:2px}
.wc .wc-period-reset {
  display:block;margin:0 0 6px auto;min-height:44px;
  color:var(--cal-navy);background:transparent;border-color:transparent;
  text-decoration:underline;text-underline-offset:3px;
}


/* calendar-fold-v1 */
.wc .wc-card-options {
  display:flex;align-items:center;justify-content:space-between;
  gap:8px;flex-wrap:wrap;margin:8px 0;
}
.wc .wc-card-options>span {font-size:14px;color:var(--wc-secondary)}
.wc .wc-card-options>div {
  display:inline-flex;gap:2px;padding:2px;border-radius:12px;background:var(--wc-soft);
}
.wc .wc-card-options button {
  min-height:44px;padding:5px 13px;border:0;background:transparent;
  color:var(--cal-navy);font-size:14px
}
.wc .wc-card-options button[aria-pressed=true] {
  background:var(--cal-navy);color:var(--wc-paper)
}
.wc .wc-card {padding:0}
.wc .wc-card-toggle {
  width:100%;display:block;padding:10px 13px;min-height:52px;
  border:0;border-radius:14px;background:transparent;text-align:start;color:var(--cal-navy)
}
.wc .wc-card-toggle:focus-visible {outline-offset:-3px}
.wc .wc-card-headline {
  display:grid;grid-template-columns:minmax(0,1fr) auto 18px;
  align-items:center;gap:9px
}
.wc .wc-card-headline strong {
  min-width:0;overflow-wrap:anywhere;font-size:18px;line-height:1.45
}
.wc .wc-card-headline .wc-time {font-size:16px;white-space:nowrap}
.wc .wc-card-toggle .wc-card-meta:not(:empty) {margin-bottom:4px}
.wc .wc-fold-chevron {color:var(--wc-secondary)}
.wc .wc-card-toggle[aria-expanded=true] .wc-fold-chevron {transform:rotate(180deg)}
.wc .wc-card-body {padding:0 13px 12px}
.wc .wc-card-body[hidden] {display:none}
@media(max-width:360px){
  .wc .wc-card-toggle {padding-inline:10px}
  .wc .wc-card-headline {column-gap:6px}
  .wc .wc-card-headline .wc-time {font-size:14px}
}


/* calendar-quick-contact-v1 */
.wc .wc-quick-contact {
  display:flex;
  align-items:stretch;
  flex-wrap:wrap;
  gap:5px;
  margin:0;
  padding:0 12px 9px;
}
.wc .wc-quick-contact a,
.wc .wc-quick-contact button {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  flex:1 1 54px;
  min-width:0;
  min-height:44px;
  padding:4px 8px;
  border-radius:9px;
  font-size:14px;
  line-height:1.25;
  text-align:center;
  text-decoration:none;
}
.wc .wc-quick-contact a:not(.wc-primary) {
  color:var(--cal-navy);
  background:var(--wc-paper);
  border-color:var(--wc-border);
}
.wc .wc-card .wc-quick-contact a.wc-primary {
  flex:1.45 1 64px;
  min-height:44px;
  color:var(--cal-navy);
  background:var(--wc-soft);
  border-color:var(--wc-border);
}
.wc .wc-card[data-next=true] .wc-quick-contact a.wc-primary {
  color:var(--cal-deep);
  background:var(--cal-action);
  border-color:var(--cal-lime);
}
.wc .wc-quick-contact .wc-add-location {
  flex:1.45 1 90px;
  color:var(--cal-navy);
  background:var(--wc-paper);
}
.wc .wc-quick-contact>small {
  align-self:center;
  flex:1 1 85px;
  font-size:13px;
  color:var(--wc-secondary);
}
.wc .wc-card-body:not([hidden]) {
  border-top:1px solid var(--wc-border);
  padding-top:8px;
}
@media(max-width:360px) {
  .wc .wc-quick-contact {padding-inline:9px;gap:4px}
  .wc .wc-quick-contact a,.wc .wc-quick-contact button {padding-inline:5px}
}


/* calendar-contact-icons-v1 */
.wc .wc-card .wc-quick-contact {
  justify-content:flex-start;
  gap:6px;
}
.wc .wc-card .wc-quick-contact a.wc-icon-link,
.wc .wc-card[data-next=true] .wc-quick-contact a.wc-icon-link {
  flex:0 0 48px;
  width:48px;height:46px;min-height:46px;
  padding:0;display:inline-flex;align-items:center;justify-content:center;
  background:transparent;border:0;box-shadow:none;
}
.wc .wc-icon-link svg {display:block;width:30px;height:30px}
.wc .wc-card .wc-quick-contact a.wc-icon-link:active {background:var(--wc-soft)}
@media(hover:hover) {
  .wc .wc-card .wc-quick-contact a.wc-icon-link:hover {background:var(--wc-soft)}
}


/* calendar-month-readability-v1 */
.wc .wc-month-panel {
  min-width:0;
  margin:12px 0;
  padding:8px 5px 0;
  border:1px solid var(--wc-border);
  border-radius:15px;
  background:var(--wc-paper);
}
.wc .wc-month-readable {
  display:grid;
  grid-template-columns:repeat(7,minmax(0,1fr));
  gap:4px 2px;
  align-items:stretch;
  width:100%;
}
.wc .wc-weekday-name {
  display:grid;
  place-items:center;
  min-width:0;
  padding:4px 0 7px;
  font-size:clamp(11px,3vw,14px);
  font-weight:650;
  line-height:1.6;
  white-space:nowrap;
  color:var(--wc-secondary);
}
.wc .wc-month-readable button.wc-month-date {
  display:grid;
  grid-template-rows:23px 15px;
  align-content:center;
  justify-content:stretch;
  justify-items:center;
  align-items:center;
  gap:1px;
  box-sizing:border-box;
  width:100%;
  min-width:0;
  min-height:50px;
  padding:3px 0;
  margin:0;
  border:1px solid transparent;
  border-radius:10px;
  background:var(--lumora-surface-soft,#f9faf7);
  color:var(--cal-navy);
  font-variant-numeric:tabular-nums;
}
.wc .wc-month-readable .wc-date-number {
  grid-row:1;
  font-size:17px;
  font-weight:650;
  line-height:1.15;
}
.wc .wc-month-readable .wc-date-count-slot {
  grid-row:2;
  display:grid;
  place-items:center;
  min-height:15px;
}
.wc .wc-month-readable button[data-booked=true] {background:#f1f8db}
.wc .wc-month-readable button[data-today=true] {
  border:2px solid var(--cal-navy);
}
.wc .wc-date-count,.wc .wc-key-count {
  display:inline-grid;place-items:center;
  min-width:19px;height:15px;padding-inline:4px;
  border-radius:5px;background:var(--cal-lime);color:var(--cal-deep);
  font-size:11px;font-weight:750;font-style:normal;line-height:1;
}
.wc .wc-month-key {
  display:flex;align-items:center;flex-wrap:wrap;gap:8px 17px;
  margin-top:8px;padding:9px 5px;
  border-top:1px solid var(--wc-border);
  font-size:12px;color:var(--wc-secondary);
}
.wc .wc-month-key>span {display:inline-flex;align-items:center;gap:5px}
.wc .wc-key-today {
  width:15px;height:15px;border:2px solid var(--cal-navy);border-radius:4px;
}
@media(max-width:360px) {
  .wc .wc-month-panel {padding-inline:2px}
  .wc .wc-month-readable {column-gap:1px}
  .wc .wc-weekday-name {font-size:11px}
}


/* calendar-compact-card-v2 */
.wc .wc-card {
  container: visit-card / inline-size;
  display: grid;
  grid-template-columns: minmax(0,1fr);
  align-items: center;
  padding: 0;
  margin-block: 8px;
  border-radius: 15px;
  background: var(--wc-paper);
  box-shadow: 0 2px 6px rgb(17 21 47 / 4%);
}
.wc .wc-card .wc-card-toggle {
  width: 100%;
  min-width: 0;
  min-height: 52px;
  padding: 10px 12px 6px;
  color: var(--cal-navy);
}
.wc .wc-card-headline {
  display: grid;
  grid-template-columns: minmax(0,1fr) 16px;
  align-items: center;
  gap: 2px 6px;
}
.wc .wc-card-headline strong {
  grid-column: 1;
  grid-row: 1;
  font-size: 18px;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.wc .wc-card-headline .wc-time {
  grid-column: 1;
  grid-row: 2;
  justify-self: start;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
  color: var(--wc-secondary);
}
.wc .wc-card-headline .wc-fold-chevron {
  grid-column: 2;
  grid-row: 1 / span 2;
  width: 15px;
}
.wc .wc-card .wc-quick-contact {
  padding: 0 8px 6px;
  margin: 0;
  gap: 2px;
}
.wc .wc-card .wc-quick-contact a.wc-icon-link,
.wc .wc-card[data-next=true] .wc-quick-contact a.wc-icon-link {
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  min-height: 44px;
}
.wc .wc-quick-contact .wc-icon-link svg {
  width: 28px;
  height: 28px;
}
.wc .wc-card .wc-card-body {
  grid-column: 1 / -1;
  min-width: 0;
  padding-inline: 12px;
}
.wc .wc-card[data-next=true] {
  border-inline-start: 4px solid var(--cal-lime);
}
.wc .wc-card .wc-card-meta:empty {display:none}

/* على الكرت الواسع، المعلومات والأيقونات بنفس الصف.
   إذا الموقع ناقص، نعطي زر إضافة الموقع سطره الكامل. */
@container visit-card (min-width: 340px) {
  .wc .wc-card-toggle:not(:has(+ .wc-quick-contact > :not(a))) {
    grid-area: 1 / 1;
    justify-self: start;
    width: calc(100% - 150px);
    padding: 11px 12px;
  }
  .wc .wc-card .wc-quick-contact:not(:has(> :not(a))) {
    grid-area: 1 / 1;
    justify-self: end;
    align-self: center;
    padding: 0 6px;
    width: max-content;
  }
}
@media (hover:hover) {
  .wc .wc-card-toggle:hover {background:var(--lumora-surface-soft,#f9faf7)}
}


/* calendar-usability-v1 */
.wc .wc-card-top {
  display:flex;flex-direction:column;align-items:stretch;
  min-width:0;grid-column:1/-1;
}
.wc .wc-card-top .wc-card-toggle {
  width:100%;min-width:0;text-align:start;
}
.wc .wc-card-top .wc-card-toggle[aria-expanded=true] .wc-fold-chevron {
  color:var(--cal-navy);
}
.wc .wc-card-top .wc-card-toggle:focus-visible {
  outline-offset:-3px;
}
.wc .wc-card .wc-card-top .wc-quick-contact {
  width:auto;align-self:stretch;padding:0 8px 7px;
}
.wc .wc-stale {
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:6px;padding:8px 10px;margin-bottom:7px;
  background:#fff7e6;border:1px solid #e7d5ae;border-radius:10px;
  color:#624c23;font-size:14px;
}
.wc .wc-stale button {min-height:44px;color:var(--cal-navy)}
@container visit-card (min-width:340px) {
  .wc .wc-card-top:not(:has(.wc-quick-contact > :not(a))) {
    flex-direction:row;align-items:center;
  }
  .wc .wc-card-top:not(:has(.wc-quick-contact > :not(a))) .wc-card-toggle {
    width:auto;flex:1 1 0%;min-width:0;padding:10px 12px;
  }
  .wc .wc-card .wc-card-top .wc-quick-contact:not(:has(> :not(a))) {
    flex:0 0 auto;align-self:center;padding:0 6px;
  }
}


/* calendar-button-hierarchy-v1 */
.wc {
  --action-radius: 12px;
  --action-shadow: 0 2px 5px rgb(17 21 47 / 10%);
}

/* إضافة موعد والبحث */
.wc .wc-tools { gap: 8px; }
.wc .wc-tools > .wc-primary {
  min-height: 48px;
  padding-inline: 18px;
  border-radius: var(--action-radius);
  border: 1px solid var(--cal-navy);
  background: var(--cal-navy);
  color: var(--wc-paper);
  font-weight: 750;
  box-shadow: var(--action-shadow);
}
.wc .wc-tools > button:not(.wc-primary) {
  min-width: 48px;
  min-height: 48px;
  border-radius: var(--action-radius);
  color: var(--cal-navy);
  background: var(--wc-paper);
  border-color: var(--wc-border);
}
.wc .wc-tools > button[aria-expanded=true] {
  background: var(--wc-soft);
  border-color: var(--cal-navy);
}

/* التنقّل */
.wc nav {
  padding: 3px;
  border-radius: var(--action-radius);
}
.wc nav button {
  min-height: 44px;
  border-radius: 9px;
  color: var(--wc-secondary);
}
.wc nav button[aria-pressed=true] {
  color: var(--cal-navy);
  background: var(--wc-paper);
  border: 1px solid var(--wc-border);
  box-shadow: inset 0 -3px var(--cal-navy);
}
.wc .wc-period-nav > button {
  min-height: 46px;
  border-radius: var(--action-radius);
  background: var(--wc-paper);
  color: var(--cal-navy);
  border-color: var(--wc-border);
  box-shadow: none;
}
.wc header > button,
.wc .wc-period-reset {
  min-height: 44px;
  color: var(--wc-secondary);
  font-size: 14px;
}
.wc .wc-card-options button {
  min-height: 44px;
  font-size: 14px;
}
.wc .wc-card-options button[aria-pressed=true] {
  color: var(--cal-navy);
  background: var(--wc-paper);
  box-shadow: inset 0 0 0 1px var(--wc-border);
}

/* التواصل وإنهاء الشغل */
.wc .wc-card[data-next=true] .wc-quick-contact a.wc-icon-link.wc-primary {
  background: #e6f8ff;
  box-shadow: inset 0 0 0 1px #b8e7f6;
  border-radius: 12px;
}
.wc .wc-work > button {
  min-height: 46px;
  padding-inline: 17px;
  border-radius: var(--action-radius);
  color: var(--wc-paper);
  background: var(--cal-navy);
  border-color: var(--cal-navy);
}
.wc .wc-manage summary {
  display: list-item;
  min-height: 44px;
  padding-block: 11px;
  color: var(--wc-secondary);
  font-weight: 600;
}
.wc .wc-manage button.wc-cancel {
  min-height: 44px;
  color: #8d332f;
  background: #fff5f3;
  border-color: #e9c9c5;
}

/* الحفظ وتأكيد القبض */
.wc .wc-submit button.wc-primary {
  min-height: 50px;
  border-radius: var(--action-radius);
  background: var(--cal-action);
  color: var(--cal-deep);
  border: 1px solid var(--cal-lime);
  font-size: 16px;
  font-weight: 750;
  box-shadow: var(--action-shadow);
}
.wc .wc-submit button.wc-primary:disabled,
.wc .wc-work > button:disabled,
.wc .wc-tools > .wc-primary:disabled {
  background: var(--wc-soft);
  border-color: var(--wc-border);
  color: var(--wc-secondary);
  opacity: 1;
  box-shadow: none;
}

/* رد فعل فوري للمس، وتركيز واضح عند استخدام الكيبورد */
.wc .wc-tools button:enabled:active,
.wc .wc-period-nav button:enabled:active,
.wc .wc-submit button:enabled:active,
.wc .wc-work > button:enabled:active,
.wc .wc-quick-contact a:active {
  filter: brightness(.93);
}
.wc button:focus-visible,
.wc a:focus-visible,
.wc summary:focus-visible {
  outline: 3px solid var(--cal-cyan);
  outline-offset: 2px;
}


/* calendar-customer-disclosure-v1 */
.wc .wc-booking-section[aria-label="الزبون"] {
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  align-items:baseline;
}
.wc .wc-booking-section[aria-label="الزبون"] > h3 {
  grid-area:1 / 1;
  margin:0 0 8px;
}
.wc .wc-booking-section[aria-label="الزبون"] > .wc-grid,
.wc .wc-booking-section[aria-label="الزبون"] > datalist {
  grid-column:1 / -1;
}
.wc .wc-booking-section > .wc-returning-option {
  grid-area:1 / 2;
  margin:0 0 4px;
}
.wc .wc-returning-option > summary {
  width:fit-content;
  margin-inline-start:auto;
  min-height:44px;
  display:flex;
  align-items:center;
  gap:5px;
  padding:4px 6px;
  border-radius:7px;
  list-style:none;
  color:var(--wc-secondary);
  font-size:13px;
  font-weight:600;
  cursor:pointer;
}
.wc .wc-returning-option > summary::-webkit-details-marker {display:none}
.wc .wc-returning-option > summary::after {
  content:"";
  width:6px;height:6px;
  border-right:1.5px solid currentColor;
  border-bottom:1.5px solid currentColor;
  transform:rotate(45deg);
}
.wc .wc-booking-section > .wc-returning-option[open] {grid-column:1 / -1}
.wc .wc-returning-option[open] > summary::after {transform:rotate(225deg)}
.wc .wc-returning-option[open] > summary {color:var(--cal-navy)}
.wc .wc-returning-option .wc-customer-picker {padding-top:3px}

/* calendar-top-row-v1 */
.la-calendar-actions {margin-inline-start:auto;min-width:0}
.la-calendar-actions:empty {display:none}
.wc-top-actions {display:flex;align-items:center;gap:4px}
.la-app .la-brand .wc-top-actions button,
.wc .wc-top-actions button {
  display:inline-flex;align-items:center;justify-content:center;
  min-height:44px;margin:0;border-radius:10px;font-size:14px;font-weight:700;
}
.la-app .la-brand .wc-top-add,.wc .wc-top-add {
  padding:6px 12px;border:1px solid var(--lumora-navy-900,#11152f);
  background:var(--lumora-navy-900,#11152f);color:white;white-space:nowrap;
}
.la-app .la-brand .wc-top-search,.wc .wc-top-search {
  width:44px;padding:0;border:1px solid var(--lumora-border,#dfe5dc);
  background:white;color:var(--lumora-navy-900,#11152f);
}
.la-app .la-brand .wc-top-add:disabled,.wc .wc-top-add:disabled {opacity:.5}
.wc .wc-period-nav {
  grid-template-columns:auto minmax(0,1fr) auto 44px;column-gap:5px;
}
.wc .wc-period-nav>.wc-view-switch {
  grid-column:4;grid-row:1;padding:0;display:grid;place-items:center;
}
.wc .wc-view-switch[aria-pressed=true] {
  background:var(--wc-soft);border-color:var(--cal-navy);
}
@media(max-width:390px){
  .la-app .la-brand:has(.la-calendar-actions:not(:empty)) {gap:4px;padding-inline:8px}
  .la-app .la-brand:has(.la-calendar-actions:not(:empty)) .la-section-icon {display:none}
  .la-app .la-brand:has(.la-calendar-actions:not(:empty))>button {padding-inline:4px}
  .wc .wc-period-nav>button {padding-inline:6px;font-size:14px}
}
@media(max-width:320px){
  .la-app .la-brand:has(.la-calendar-actions:not(:empty)) {flex-wrap:wrap}
}


/* calendar-card-reading-order-v1 */
.wc .wc-card {
  margin-block: 8px;
  border: 1px solid var(--wc-border);
  border-radius: 15px;
  background: var(--wc-paper);
  color: var(--cal-navy);
  box-shadow: 0 1px 3px rgb(17 21 47 / 5%);
}
.wc .wc-card[data-next=true] {
  border-inline-start: 4px solid var(--cal-lime);
}
.wc .wc-card-top .wc-card-toggle {
  text-align: start;
  min-height: 60px;
}
.wc .wc-card-headline {
  display: grid;
  grid-template-columns: minmax(0,1fr) 16px;
  grid-template-rows: auto auto;
  align-items: center;
  gap: 2px 7px;
}
.wc .wc-card-headline .wc-time {
