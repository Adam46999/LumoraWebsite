    act(async () => {
      const ref = refFor(r.id);
      await runTransaction(db, async tx => {
        const snapshot = await tx.get(ref);
        if (!snapshot.exists()) throw Error("الموعد انحذف من قبل.");
        const current = snapshot.data();
