  for (const [type,raw] of Object.entries(f.items)) {
    const qty = digits(raw).trim();
    if (qty && (!/^\d{1,5}$/.test(qty) || Number(qty) < 1)) throw Error("افحص كمية " + type);
    items[type] = qty;
  }
