import { useEffect, useState } from "react";
import { collection, doc, onSnapshot, runTransaction } from "firebase/firestore";
import { db } from "../../firebase";

const galleryRef = collection(db, "lumora_gallery");

function mergePairs(originals, records) {
  const pairs = new Map();

  originals.forEach((pair, index) => {
    const id = "original-" + (index + 1);
    pairs.set(id, { ...pair, id, rev: 0 });
  });

  for (const record of [...records].sort((a, b) => a.id.localeCompare(b.id))) {
    const original = pairs.get(record.id);
    const before = record.before || original?.before;
    const after = record.after || original?.after;

    if (before && after) {
      pairs.set(record.id, { id: record.id, before, after, rev: record.rev });
    }
  }

  const order = records.find(record => record.id === "display-order")?.ids;
  const ordered = [];

  for (const id of Array.isArray(order) ? order : []) {
    if (pairs.has(id)) {
      ordered.push(pairs.get(id));
      pairs.delete(id);
    }
  }

  return [...ordered, ...pairs.values()];
}

export function useGallery(originals) {
  const [records, setRecords] = useState([]);
  const [status, setStatus] = useState("loading");
  const [attempt, setAttempt] = useState(0);

  useEffect(() => {
    setStatus("loading");
    return onSnapshot(
      galleryRef,
      { includeMetadataChanges: true },
      snapshot => {
        setRecords(snapshot.docs.map(item => ({ ...item.data(), id: item.id })));
        setStatus(snapshot.metadata.fromCache ? "offline" : "ready");
      },
      error => setStatus(error.code === "permission-denied" ? "denied" : "error")
    );
  }, [attempt]);

  return {
    pairs: mergePairs(originals, records),
    orderVersion: records.find(record => record.id === "display-order")?.rev || 0,
    status,
    retry: () => setAttempt(value => value + 1)
  };
}

export async function saveGalleryOrder(ids, expectedVersion) {
  const ref = doc(galleryRef, "display-order");

  await runTransaction(db, async transaction => {
    const previous = (await transaction.get(ref)).data();
    const version = previous?.rev || 0;

    if (version !== expectedVersion) throw new Error("ORDER_CONFLICT");
    transaction.set(ref, { ids, rev: version + 1 });
  });
}

export async function savePair(pair, changes) {
  const ref = doc(galleryRef, pair.id);

  await runTransaction(db, async transaction => {
    const previous = (await transaction.get(ref)).data();

    if ((previous?.rev || 0) !== pair.rev) {
      throw new Error("CONFLICT");
    }

    transaction.set(ref, {
      before: changes.before || previous?.before || "",
      after: changes.after || previous?.after || "",
      rev: pair.rev + 1
    });
  });
}

export async function preparePhoto(file) {
  if (file.size > 25 * 1024 * 1024) {
    throw new Error("الصورة أكبر من 25 ميغابايت. اختار نسخة أصغر.");
  }

  const url = URL.createObjectURL(file);

  try {
    const image = new Image();
    image.src = url;

    try {
      await image.decode();
    } catch {
      throw new Error("تعذّر فتح الصورة. جرّب JPG أو PNG أو WebP.");
    }

    const canvas = document.createElement("canvas");

    for (const maxSide of [1440, 1200, 960, 720]) {
      const scale = Math.min(1, maxSide / Math.max(image.width, image.height));
      canvas.width = Math.max(1, Math.round(image.width * scale));
      canvas.height = Math.max(1, Math.round(image.height * scale));

      const context = canvas.getContext("2d");
      context.fillStyle = "#fff";
      context.fillRect(0, 0, canvas.width, canvas.height);
      context.drawImage(image, 0, 0, canvas.width, canvas.height);

      for (const quality of [0.84, 0.72, 0.6]) {
        const result = canvas.toDataURL("image/jpeg", quality);
        if (result.startsWith("data:image/jpeg;base64,") && result.length <= 200000) {
          return result;
        }
      }
    }

    throw new Error("تعذّر تصغير الصورة. جرّب نسخة أصغر.");
  } finally {
    URL.revokeObjectURL(url);
  }
}
</file>

<file path="src/components/BefAfter/GalleryManager.jsx">
import { useLayoutEffect as useGalleryLayoutEffect } from "react";
import React, { useRef, useState } from "react";
import { auth } from "../../firebase";
import { preparePhoto, savePair, saveGalleryOrder } from "./gallery";

const button = "min-h-12 rounded-xl border px-4 py-2 font-bold disabled:opacity-50";
const primary = button + " bg-slate-900 text-white";
const sides = [["before", "قبل"], ["after", "بعد"]];

function galleryRules(uid) {
  return [
    "match /lumora_gallery/{pairId} {",
    '  function manager() { return request.auth != null && request.auth.uid == "' + uid + '"; }',
    "  function validSide(v) {",
    '    return v is string && v.size() <= 200000 && (v == "" || v.matches("data:image/jpeg;base64,[A-Za-z0-9+/=]+"));',
    "  }",
    "  function validPair() {",
    "    let d = request.resource.data;",
    '    return d.keys().hasAll(["before","after","rev"])',
    '      && d.keys().hasOnly(["before","after","rev"])',
    "      && d.rev is int && validSide(d.before) && validSide(d.after)",
    '      && ((pairId.matches("original-([1-9]|10)") && (d.before != "" || d.after != ""))',
    '        || (pairId.matches("new-[0-9]+-[0-9]+-[0-9]+") && d.before != "" && d.after != ""));',
    "  }",
    "  allow read: if true;",
    "  allow create: if manager() && validPair() && request.resource.data.rev == 1;",
    "  allow update: if manager() && validPair() && request.resource.data.rev == resource.data.rev + 1;",
    "}",
    "match /lumora_gallery/display-order {",
    '  function canOrder() { return request.auth != null && request.auth.uid == "' + uid + '"; }',
    "  function validOrder() {",
    "    let d = request.resource.data;",
    '    return d.keys().hasAll(["ids", "rev"]) && d.keys().hasOnly(["ids", "rev"])',
    "      && d.rev is int && d.ids is list && d.ids.size() > 0",
    "      && d.ids.size() == d.ids.toSet().size();",
    "  }",
    "  allow create: if canOrder() && validOrder() && request.resource.data.rev == 1;",
    "  allow update: if canOrder() && validOrder() && request.resource.data.rev == resource.data.rev + 1;",
    "}"
  ].join("\n");
}

export default function GalleryManager({ gallery,embedded=false,leaveGuard,onHome }) {
  const Surface=embedded ? "section" : "dialog";
  const dialog = useRef(null);
  const locked = useRef(false);
  const [pair, setPair] = useState(null);
  const [changes, setChanges] = useState({});
  const [busy, setBusy] = useState("");
  const [message, setMessage] = useState("");
  const ready = gallery.status === "ready";
  const [order, setOrder] = useState(null);
  const orderChanged = !!order && order.ids.some((id, index) => id !== order.initial[index]);
  const dirty = orderChanged || Object.keys(changes).length > 0;

  function startOrdering() {
    const ids = gallery.pairs.map(item => item.id);
    setOrder({ ids, initial: ids, version: gallery.orderVersion });
    setMessage("");
    dialog.current.scrollTop = 0;
  }

  function move(id, step) {
    setOrder(current => {
      if (!current) return current;
      const ids = [...current.ids];
      const index = ids.indexOf(id);
      const target = index + step;
      if (index < 0 || target < 0 || target >= ids.length) return current;
      [ids[index], ids[target]] = [ids[target], ids[index]];
      return { ...current, ids };
    });
  }

  function publishOrder() {
    run("جارٍ حفظ الترتيب…", async () => {
      await saveGalleryOrder(order.ids, order.version);
      edit(null);
      setMessage("تم حفظ ترتيب الصور.");
    });
  }

  function edit(item) {
    setOrder(null);
    setPair(item);
    setChanges({});
    setMessage("");
    if (dialog.current) dialog.current.scrollTop = 0;
  }

  useGalleryLayoutEffect(()=>{
    if (!leaveGuard) return;
    leaveGuard.current=()=>!locked.current && (!dirty || window.confirm("تترك تغييرات الصور وتنتقل؟"));
    return ()=>{leaveGuard.current=null;};
  },[leaveGuard,dirty]);
  function back() {
    if (locked.current) return;
    if (dirty && !window.confirm("ترك التغييرات بدون حفظ؟")) return;
    if (pair || order) edit(null);
    else if (embedded) onHome(); else dialog.current.close();
  }

  async function run(label, work) {
    if (locked.current) return;
    locked.current = true;
    setBusy(label);
    setMessage("");

    try {
      await work();
    } catch (error) {
      if (error.message === "ORDER_CONFLICT") {
        setMessage("انحفظ ترتيب أحدث من جهاز ثاني. ارجع للقائمة وافتح ترتيب الصور من جديد.");
      } else if (error.message === "CONFLICT") {
        setMessage("تغيّرت المقارنة من جهاز آخر. ارجع للقائمة وافتحها من جديد.");
      } else if (error.code === "permission-denied") {
        setMessage("حسابك ما معه صلاحية للحفظ. افحص قواعد المعرض.");
      } else if (error.code) {
        setMessage("تعذّر الحفظ. افحص الاتصال وجرّب مرة ثانية.");
      } else {
        setMessage(error.message);
      }
    } finally {
      locked.current = false;
      setBusy("");
    }
  }

  function choose(event, side) {
    const file = event.target.files?.[0];
    event.target.value = "";
    if (!file) return;

    run("جارٍ تجهيز الصورة…", async () => {
      const image = await preparePhoto(file);
      setChanges(previous => ({ ...previous, [side]: image }));
    });
  }

  function save() {
    run("جارٍ حفظ المقارنة…", async () => {
      await savePair(pair, changes);
      edit(null);
      setMessage("تم حفظ المقارنة.");
    });
  }

  async function copyRules() {
    const uid = auth.currentUser?.uid;
    if (!uid || !/^[a-zA-Z0-9_-]+$/.test(uid)) {
      setMessage("تعذّر تحديد حساب المدير. سجّل الدخول من جديد.");
      return;
    }
    const rules = galleryRules(uid);
    try {
      await navigator.clipboard.writeText(rules);
      setMessage("تم نسخ قواعد المعرض.");
    } catch {
      window.prompt("انسخ قواعد المعرض", rules);
    }
  }

  return <>
    {!embedded && <button type="button" className={primary + " w-full"} onClick={() => {
      edit(null);
      dialog.current.showModal();
    }}>
      إدارة صور قبل وبعد
    </button>}

    <Surface data-embedded={embedded} ref={dialog} dir="rtl" aria-label="إدارة صور قبل وبعد"
      onCancel={event => { event.preventDefault(); back(); }}
      className="fixed inset-0 m-auto max-h-[92dvh] w-[96vw] max-w-2xl overflow-auto overscroll-contain rounded-2xl bg-white p-4 backdrop:bg-black/50">

      {(!embedded || pair || order) && <header data-admin-step="" className="mb-4 flex items-center justify-between gap-2">
        <h2 className="text-lg font-bold">{order ? "ترتيب الصور" : pair ? "معاينة المقارنة" : "صور قبل وبعد"}</h2>
        <button type="button" disabled={!!busy} className={button} onClick={back}>
          {pair || order ? "رجوع" : "إغلاق"}
        </button>
      </header>}

      {!ready && <div role="status" className="mb-3 rounded-xl bg-amber-50 p-3">
        {gallery.status === "loading" ? "جارٍ تحميل المعرض…" :
          <>
            <p>{gallery.status === "denied" ? "المعرض بحاجة لتفعيل الصلاحيات." : "تعذّر الاتصال بالمعرض."}</p>
            <button type="button" className={button + " mt-2"} onClick={gallery.retry}>إعادة المحاولة</button>
          </>}
      </div>}

      {!pair && !order && <details className="mb-3 text-sm">
        <summary className="cursor-pointer py-2">إعداد صلاحيات المعرض</summary>
        <button type="button" className={button} onClick={copyRules}>نسخ قواعد المعرض</button>
      </details>}

      <p aria-live="polite" className="mb-2 font-bold">{busy || message}</p>

      {order ? <>
        <ol className="space-y-2">
          {order.ids.map((id, index) => {
            const item = gallery.pairs.find(photo => photo.id === id);
            if (!item) return null;
            return <li key={id} className="flex items-center gap-2 rounded-xl border p-2">
              <span className="w-6 shrink-0 text-center font-bold">{index + 1}</span>
              <div className="grid min-w-0 flex-1 grid-cols-2 gap-1">
                {sides.map(([side, label]) => <div key={side}>
                  <img src={item[side]} alt={label} loading="lazy"
                    className="aspect-square max-h-20 w-full rounded-lg object-cover" />
                  <span className="text-xs">{label}</span>
                </div>)}
              </div>
              <div className="flex shrink-0 flex-col gap-1">
                <button type="button" className={button}
                  aria-label={"تقديم المقارنة رقم " + (index + 1)}
                  disabled={!!busy || index === 0} onClick={() => move(id, -1)}>↑</button>
                <button type="button" className={button}
                  aria-label={"تأخير المقارنة رقم " + (index + 1)}
                  disabled={!!busy || index === order.ids.length - 1} onClick={() => move(id, 1)}>↓</button>
              </div>
            </li>;
          })}
        </ol>
        <div className="sticky bottom-0 bg-white py-2">
          <button type="button" className={primary + " w-full"}
            disabled={!ready || !!busy || !orderChanged} onClick={publishOrder}>حفظ الترتيب</button>
        </div>
      </> : pair ? <>
        <div className="grid grid-cols-2 gap-2">
          {sides.map(([side, label]) => <div key={side} className="min-w-0">
            <strong>{label}</strong>
            {changes[side] || pair[side]
              ? <img src={changes[side] || pair[side]} alt={label}
                  className="my-2 aspect-square w-full rounded-xl bg-slate-100 object-contain" />
              : <div className="my-2 aspect-square rounded-xl bg-slate-100" />}
            <label className={button + " relative flex items-center justify-center text-center focus-within:ring-2"}>
              {changes[side] || pair[side] ? "تبديل" : "اختيار"} صورة {label}
              <input type="file" accept="image/*" disabled={!!busy}
                aria-label={"اختيار صورة " + label}
                className="absolute inset-0 h-full w-full cursor-pointer opacity-0"
                onChange={event => choose(event, side)} />
            </label>
          </div>)}
        </div>
        <button type="button" className={primary + " mt-5 w-full"}
          disabled={!ready || !!busy || !dirty || !(pair.before || changes.before) || !(pair.after || changes.after)}
          onClick={save}>
          حفظ المقارنة
        </button>
      </> : <>
        <button type="button" className={primary + " mb-3 w-full"} disabled={!ready}
          onClick={() => edit({
            id: "new-" + Date.now() + "-" + crypto.getRandomValues(new Uint32Array(2)).join("-"),
            rev: 0
          })}>
          إضافة مقارنة
        </button>

        <button type="button" className={button + " mb-3 w-full"}
          disabled={!ready || gallery.pairs.length < 2} onClick={startOrdering}>
          ترتيب الصور
        </button>
        <div className="grid gap-3 sm:grid-cols-2">
          {gallery.pairs.map((item, index) => <button type="button" key={item.id}
            disabled={!ready} onClick={() => edit(item)} className="rounded-xl border p-2 text-start">
            <strong>تعديل المقارنة {index + 1}</strong>
            <span className="mt-2 grid grid-cols-2 gap-2">
              {sides.map(([side, label]) => <span key={side}>
                <img src={item[side]} alt="" loading="lazy"
                  className="aspect-video w-full rounded-lg object-cover" />
                {label}
              </span>)}
            </span>
          </button>)}
        </div>
      </>}
    </Surface>
  </>;
}
</file>

<file path="src/components/contact/ContactField.jsx">
// src/components/contact/ContactField.jsx
import React, { useState, useEffect, useRef } from "react";
import {
  User,
  Phone,
  MessageSquare,
  CheckCircle2,
  AlertCircle,
} from "lucide-react";

export default function ContactField({
  id,
  label,
  placeholder,
  value,
  onChange,
  onBlur,
  error,
  isTextArea = false,
  isValid = false,
  required = false,
  maxChars = 500,
  smartCounter = false,
  isRTL = false,
  refEl,
  autoGrow,
  onEnterNext,
  inputProps = {},

  // ✅ NEW (عشان يركب مع ContactForm بدون كسر)
  assistiveText,
  shake = false,
}) {
  const [charCount, setCharCount] = useState(0);
  const taRef = useRef(null);

  useEffect(() => {
    if (id === "message") setCharCount(value?.length || 0);
  }, [value, id]);

  useEffect(() => {
    if (!autoGrow || !isTextArea) return;
    const el = taRef.current;
    if (!el) return;
    el.style.height = "auto";
    el.style.height = Math.min(el.scrollHeight, 360) + "px";
  }, [value, autoGrow, isTextArea]);

  const sidePad = isRTL
    ? "pr-11 sm:pr-12 text-right"
    : "pl-11 sm:pl-12 text-left";
  const iconPos = isRTL ? "right-2.5 sm:right-3" : "left-2.5 sm:left-3";

  const base = `
    w-full px-3 sm:px-4 py-2.5 sm:py-3 ${sidePad}
    rounded-xl border transition-[border,box-shadow] duration-150 focus:outline-none
    bg-white text-[15px] sm:text-[16px] text-gray-900 placeholder-gray-400
  `;

  const stateColor = error
    ? "border-rose-300 focus:border-rose-400 shadow-[0_0_0_3px_rgba(244,63,94,.10)]"
    : isValid
    ? "border-emerald-200 focus:border-emerald-400 shadow-[0_0_0_3px_rgba(16,185,129,.10)]"
    : "border-gray-200 focus:border-blue-500 shadow-[0_0_0_3px_rgba(59,130,246,.10)]";

  const cls = `${base} ${stateColor} ${shake ? "animate-shake" : ""}`;

  const Icon = id === "name" ? User : id === "phone" ? Phone : MessageSquare;
  const StatusIcon = error ? AlertCircle : isValid ? CheckCircle2 : null;

  const onKeyDown = (e) => {
    if (e.key === "Enter" && !isTextArea && typeof onEnterNext === "function") {
      e.preventDefault();
      onEnterNext();
    }
  };

  const showCounter =
    id === "message" && (!smartCounter || charCount >= maxChars * 0.75);

  return (
    <div
      className={`${
        id === "message" ? "col-span-full" : ""
      } flex flex-col gap-1`}
    >
      <label
        htmlFor={id}
        className="mb-0.5 text-sm font-semibold text-gray-800"
      >
        {label} {required && <span className="text-rose-500">*</span>}
      </label>

      <div className="relative">
        {/* أيقونة داخل كبسولة أصغر */}
        <span
          className={`absolute ${iconPos} top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-[26px] h-[26px] rounded-lg bg-blue-50 text-blue-600 border border-blue-100`}
        >
          <Icon className="w-[18px] h-[18px]" aria-hidden="true" />
        </span>

        {isTextArea ? (
          <textarea
            id={id}
            ref={(node) => {
              taRef.current = node;
              if (refEl) refEl.current = node;
            }}
            value={value}
            onChange={onChange}
            onBlur={onBlur}
            onKeyDown={onKeyDown}
            placeholder={placeholder}
            rows={4}
            maxLength={maxChars}
            aria-invalid={!!error}
            className={`${cls} resize-none`}
            required={required}
            {...inputProps}
          />
        ) : (
          <input
            id={id}
            type={id === "phone" ? "tel" : "text"}
            inputMode={id === "phone" ? "tel" : "text"}
            autoComplete={
              id === "name" ? "name" : id === "phone" ? "tel" : "off"
            }
            value={value}
            onChange={onChange}
            onBlur={onBlur}
            onKeyDown={onKeyDown}
            placeholder={placeholder}
            aria-invalid={!!error}
            className={cls}
            required={required}
            {...inputProps}
          />
        )}

        {/* حالة صحيحة/خطأ */}
        {StatusIcon && (
          <span
            className={`absolute ${
              isRTL ? "left-2.5 sm:left-3" : "right-2.5 sm:right-3"
            } top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-[26px] h-[26px] rounded-lg ${
              error
                ? "bg-rose-50 text-rose-600 border border-rose-100"
                : "bg-emerald-50 text-emerald-600 border border-emerald-100"
            }`}
          >
            <StatusIcon className="w-[18px] h-[18px]" aria-hidden="true" />
          </span>
        )}
      </div>

      {/* ✅ مساعد تحت الحقل (موجود بالـ ContactForm) */}
      {assistiveText && !error && (
        <span className="text-[12px] sm:text-xs mt-1 text-gray-600">
          {assistiveText}
        </span>
      )}

      {/* ✅ error تحت الحقل */}
      {error && (
        <span className="text-[12px] sm:text-xs mt-1 text-rose-600 font-medium">
          {error}
        </span>
      )}

      {showCounter && (
        <span
          className={`text-[12px] sm:text-xs mt-1 self-start ${
            charCount > maxChars * 0.9
              ? "text-rose-600"
              : charCount > maxChars * 0.75
              ? "text-amber-600"
              : "text-gray-500"
          }`}
        >
          {charCount} / {maxChars}
        </span>
      )}

      <style>{`
        @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}
        .animate-shake{animation:shake .3s ease-in-out}
        @media (prefers-reduced-motion: reduce){
          .animate-shake{animation:none}
        }
      `}</style>
    </div>
  );
}
