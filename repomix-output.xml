                "backdrop-blur-xl",
              ].join(" ")
            : [
                "border-white/[0.08]",
                "bg-[rgba(8,12,29,0.94)]",
                "backdrop-blur-lg",
              ].join(" "),
        ].join(" ")}
      >
        <div className="mx-auto max-w-7xl px-3 sm:px-6">
          <div className="flex h-[66px] items-center justify-between gap-2 sm:h-[72px]">
            {/* Logo */}
            <button
              type="button"
              dir="ltr"
