                                  w-8
                                  shrink-0
                                  items-center
                                  justify-center
                                  rounded-lg
                                  bg-[rgba(16,148,192,0.10)]
                                  text-[var(--lumora-cyan-light)]
                                "
                            >
                              <Icon aria-hidden="true" className="h-4 w-4" />
                            </span>

                            <span className="flex-1">{service.label}</span>

                            {active && (
                              <Check aria-hidden="true" className="h-4 w-4" />
