.wc .wc-customer-results small {padding:4px;color:var(--muted)}


/* calendar-visual-v5 */
.wc {
  --wc-paper:#fff;
  --wc-surface:#f5f8f5;
  --wc-brand:#115c4e;
  --wc-soft:#eaf3ed;
  --wc-text:#19382f;
