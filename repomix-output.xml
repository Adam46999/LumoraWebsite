// src/header/SidebarMenu.jsx
import { useCallback, useEffect, useMemo, useRef, useState } from "react";

import { createPortal } from "react-dom";

import {
  Check,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  Globe2,
  Sparkles,
  X,
} from "lucide-react";

import { useLanguage } from "../context/LanguageContext";

const LANGUAGE_OPTIONS = [
  {
    code: "ar",
    short: "AR",
    label: "العربية",
  },
  {
    code: "en",
    short: "EN",
    label: "English",
  },
  {
    code: "he",
    short: "HE",
    label: "עברית",
  },
];

export default function SidebarMenu({
  menuOpen,
  setMenuOpen,
  navItems = [],
  scrollToSection,
  activeId,
  hintText,
  labels,
}) {
  const { lang, setLang } = useLanguage();

  const isRTL = lang === "ar" || lang === "he";
  const direction = isRTL ? "rtl" : "ltr";

  const panelRef = useRef(null);
  const [openParentId, setOpenParentId] = useState(null);

  const ArrowIcon = useMemo(
    () => (isRTL ? ChevronLeft : ChevronRight),
    [isRTL],
  );

  const text = useMemo(() => {
    if (lang === "he") {
      return {
        menuTitle: "תפריט ראשי",
        menuSubtitle: "ניווט מהיר באתר",
        languageTitle: "בחירת שפה",
        allServices: "כל השירותים",
        close: "סגירת התפריט",
        active: "פעיל",
        brandSub: "CLEANING",
      };
    }

    if (lang === "en") {
      return {
        menuTitle: "Main menu",
        menuSubtitle: "Quick website navigation",
        languageTitle: "Choose language",
        allServices: "All services",
        close: "Close menu",
        active: "Active",
        brandSub: "CLEANING",
      };
    }

    return {
      menuTitle: "القائمة الرئيسية",
      menuSubtitle: "تنقّل سريع داخل الموقع",
      languageTitle: "اختر اللغة",
      allServices: "كل الخدمات",
      close: "إغلاق القائمة",
      active: "محدد",
      brandSub: "CLEANING",
    };
  }, [lang]);

  const closeMenu = useCallback(() => {
    setMenuOpen(false);
    setOpenParentId(null);
  }, [setMenuOpen]);

  const goToSection = useCallback(
    (id) => {
      if (!id) {
        return;
      }

      try {
        scrollToSection?.(id);
      } finally {
        closeMenu();
      }
    },
    [closeMenu, scrollToSection],
  );

  useEffect(() => {
    if (!menuOpen) {
      setOpenParentId(null);
      return undefined;
    }

    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";

    const handleEscape = (event) => {
      if (event.key === "Escape") {
        closeMenu();
      }
    };

    window.addEventListener("keydown", handleEscape);

    const focusTimer = window.setTimeout(() => {
      panelRef.current?.focus();
    }, 30);

    return () => {
      window.clearTimeout(focusTimer);
      window.removeEventListener("keydown", handleEscape);
      document.body.style.overflow = previousOverflow;
    };
  }, [closeMenu, menuOpen]);

  useEffect(() => {
    if (!menuOpen) {
      return;
    }

    const activeParent = navItems.find((item) =>
      item?.subItems?.some((subItem) => subItem.id === activeId),
    );

    if (activeParent?.id) {
      setOpenParentId(activeParent.id);
    }
  }, [activeId, menuOpen, navItems]);

  if (!menuOpen || typeof document === "undefined") {
    return null;
  }

  const content = (
    <div
      className="fixed inset-0 z-[10000]"
      role="presentation"
      dir={direction}
    >
      {/* Backdrop */}
      <button
        type="button"
        aria-label={text.close}
        onClick={closeMenu}
        className="
          absolute
          inset-0
          h-full
          w-full
          cursor-default
          bg-[rgba(3,7,24,0.76)]
          backdrop-blur-sm
        "
      />

      {/* Sidebar panel */}
      <aside
        ref={panelRef}
        tabIndex={-1}
        role="dialog"
        aria-modal="true"
        aria-label={text.menuTitle}
        className={[
          "absolute top-0 h-[100dvh]",
          "w-[min(92vw,390px)]",
          "overflow-hidden",
          "border-white/10",
          "bg-gradient-to-b",
          "from-[var(--lumora-navy-900)]",
          "via-[var(--lumora-navy-950)]",
          "to-[#050817]",
          "text-white",
          "shadow-[0_0_80px_rgba(0,0,0,0.55)]",
          "focus:outline-none",
          isRTL ? "right-0 border-l" : "left-0 border-r",
        ].join(" ")}
      >
        {/* Decorative logo watermark */}
        <img
          src="/lumora-icon.png"
          alt=""
          aria-hidden="true"
          draggable={false}
          className={[
            "pointer-events-none",
            "absolute -top-24",
            "h-72 w-72",
            "select-none object-contain",
            "opacity-[0.055]",
            isRTL ? "-left-24" : "-right-24",
          ].join(" ")}
        />

        {/* Decorative glows */}
        <div
          aria-hidden="true"
          className="
            pointer-events-none
            absolute
            -right-24
            top-28
            h-56
            w-56
            rounded-full
            bg-[rgba(16,148,192,0.16)]
            blur-3xl
          "
        />

        <div
          aria-hidden="true"
          className="
            pointer-events-none
            absolute
            -bottom-24
            -left-20
            h-64
            w-64
            rounded-full
            bg-[rgba(174,221,57,0.10)]
            blur-3xl
          "
        />

        <div className="relative z-10 flex h-full flex-col">
          {/* Header */}
          <div
            className="
              shrink-0
              border-b
              border-white/[0.08]
              px-4
              pb-4
              pt-[max(16px,env(safe-area-inset-top))]
            "
          >
            <div className="flex items-center justify-between gap-3">
              <button
                type="button"
                onClick={() => goToSection("home")}
                className="
                  flex
                  min-w-0
                  items-center
                  gap-3
                  rounded-2xl
                  text-start
                "
              >
                <span
                  className="
                    flex
                    h-14
                    w-14
                    shrink-0
                    items-center
                    justify-center
                    overflow-hidden
                    rounded-full
                    border
                    border-[rgba(174,221,57,0.38)]
                    bg-[var(--lumora-navy-900)]
                    shadow-[0_0_28px_rgba(16,148,192,0.18)]
                  "
                >
                  <img
                    src="/lumora-icon.png"
                    alt="Lumora"
                    draggable={false}
                    className="h-full w-full object-cover"
                  />
                </span>

                <span className="min-w-0">
                  <span
                    className="
                      block
                      truncate
                      text-lg
                      font-black
                      leading-none
                      tracking-[0.08em]
                      text-white
                    "
                  >
                    LUMORA
                  </span>

                  <span
                    className="
                      mt-1.5
                      block
                      text-[9px]
                      font-black
                      leading-none
                      tracking-[0.32em]
                      text-[var(--lumora-lime)]
                    "
                  >
                    {text.brandSub}
                  </span>
                </span>
              </button>

              <button
                type="button"
                onClick={closeMenu}
                aria-label={text.close}
                className="
                  flex
                  h-11
                  w-11
                  shrink-0
                  items-center
                  justify-center
                  rounded-2xl
                  border
                  border-white/10
