                {text.faq}
              </button>
            </nav>

            {/* Desktop actions */}
            <div className="hidden items-center gap-2 lg:flex">
              <div ref={desktopLanguageRef} className="relative">
                <button
                  type="button"
                  onClick={() => {
                    setLanguageOpen((current) => !current);

                    setServicesOpen(false);
                  }}
                  className="
